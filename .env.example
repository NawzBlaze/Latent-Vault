# LATENT VAULT — environment reference.
#
# These are the ONLY variables the runtime code reads (verified 2026-09-09 by
# grepping every `process.env.*` reference under src/):
#
#   NEXT_PUBLIC_SITE_URL   src/lib/site.ts
#   SOURCE_ORIGIN          src/source/adapter.ts
#   YUHU_WORKER_URL        src/source/yuhu.ts
#   NODE_ENV               framework built-in
#
# Both source variables are OPTIONAL: each has a hardcoded default that matches
# the live source today. Set them only to point the app at a different origin.
#
# Development-only (tests/e2e, never read by the app):
#   E2E_PORT, E2E_BASE_URL  playwright.config.ts

# Public canonical origin of the deployed site (SEO / canonical / OG URLs).
NEXT_PUBLIC_SITE_URL=https://latent-vault.vercel.app

# Primary media source. Optional — defaults to https://index.csbots.live.
# SOURCE_ORIGIN=https://index.csbots.live

# okcdn resolver worker used by the Yuhu client. Optional —
# defaults to https://okcdn.okcdn-api.workers.dev.
# YUHU_WORKER_URL=https://okcdn.okcdn-api.workers.dev
